# Copie este arquivo para ".env" (local) e preencha. NUNCA envie o .env para o GitHub.
# Na nuvem, os mesmos nomes vão em: GitHub > Settings > Secrets  e  Vercel > Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-ou-publishable
# Connection string do pooler (Project Settings > Database > Connection string > Transaction pooler, porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Mercado Livre (developers.mercadolivre.com.br > Meus aplicativos) ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://SEU-SITE.vercel.app/api/oauth/mercadolivre/callback

# --- Sincronização ---
# Dias de histórico na primeira carga
BACKFILL_DAYS=365
# (opcional) URL de ping do Healthchecks.io
HEALTHCHECK_URL=
